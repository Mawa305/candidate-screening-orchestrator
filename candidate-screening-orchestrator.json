    {
      "parameters": {
        "promptType": "define",
        "text": "=Job title: {{ $json.job_title }}\nDepartment: {{ $json.route }}\nResume:\n{{ $json.resume_text }}\n\nEvaluate this candidate and return the JSON.",
        "options": {
          "systemMessage": "You are a recruitment skill-match evaluator. Compare the candidate's resume against the job title and the department (route).\nScore the match from 0 to 100:\n- 80-100: strong match, most core skills clearly shown\n- 60-79: partial match, some relevant skills but gaps\n- 0-59: weak match, few or no relevant skills\n\nRules:\n- Use only the information in the resume. Do not assume skills that are not written.\n- Keep the reason to one short line, mentioning the strongest match or the main gap.\n- Return only valid JSON in this exact format, with no extra text and no markdown:\n{\"score\": 0, \"reason\": \"one short line\"}"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1024,
        -16
      ],
      "id": "99449023-ecf0-4ee8-bef3-e1f7317452c4",
