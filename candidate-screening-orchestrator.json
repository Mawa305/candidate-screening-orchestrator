    {
      "parameters": {
        "promptType": "define",
        "text": "=Candidate details:\n{{ JSON.stringify($json.body) }}\n\nClassify this candidate and return the JSON.",
        "options": {
          "systemMessage": "You are a recruitment supervisor. Route each candidate to exactly one department based on the job title:\n- \"technical\": engineering, development, data, IT, automation, or DevOps roles\n- \"sales\": sales, business development, account management, or marketing roles\n- \"general\": any other role\n\nRules:\n- Use only the information provided. Do not invent details.\n- Return only valid JSON in this exact format, with no extra text and no markdown:\n{\"route\": \"technical\" | \"sales\" | \"general\", \"reason\": \"one short line explaining why\"}"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        224,
        -16
      ],
      "id": "e8e201af-ed02-402d-906b-6fbfbc2001b0",
      "name": "Supervisor Agent"
    },
    {
