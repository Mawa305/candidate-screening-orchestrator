        "jsCode": "const raw = $json.output.replace(/```json|```/g, '').trim();\nconst parsed = JSON.parse(raw);\nconst candidate = $('Webhook').first().json.body;\n\nreturn [{ json: { ...candidate, route: parsed.route, reason: parsed.reason } }];"
